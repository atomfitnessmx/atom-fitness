<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ventas (Solo Documentos Propios): pueden VER todos los leads/oportunidades
         de todos los vendedores, pero solo pueden EDITAR/CREAR/ELIMINAR los suyos.
         Se logra con dos reglas separadas por tipo de permiso sobre el mismo grupo:
         una para lectura (domain abierto) y otra para escritura (domain propio). -->

    <record id="crm_lead_rule_ver_todos" model="ir.rule">
        <field name="name">Ventas: Ver todos los leads (solo lectura)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">True</field>
        <field name="perm_write">False</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>

    <record id="crm_lead_rule_editar_propios" model="ir.rule">
        <field name="name">Ventas: Editar solo leads propios</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read">False</field>
        <field name="perm_write">True</field>
        <field name="perm_create">True</field>
        <field name="perm_unlink">True</field>
    </record>
</odoo>
