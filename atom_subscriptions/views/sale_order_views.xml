<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_atom_subscriptions" model="ir.ui.view">
        <field name="name">sale.order.form.atom.subscriptions</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Botón Convertir a Arrendamiento -->
            <xpath expr="//button[@name='action_confirm'][1]" position="before">
                <field name="tiene_producto_rentable" invisible="1"/>
                <field name="es_arrendamiento" invisible="1"/>
                <button name="action_convertir_arrendamiento"
                    type="object"
                    string="Convertir a Arrendamiento"
                    class="btn-secondary"
                    invisible="not tiene_producto_rentable or es_arrendamiento or state not in ('draft','sent')"
                    confirm="Esto pondrá en $0 las líneas de equipo cotizadas y creará una línea consolidada del servicio de arrendamiento. ¿Continuar?"/>
            </xpath>

            <!-- Smartbutton Activos Fijos -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_assets"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-cogs"
                    invisible="not es_arrendamiento or asset_count == 0">
                    <field name="asset_count" widget="statinfo" string="Activos Fijos"/>
                </button>
            </xpath>

            <!-- Campos de renta después del plan_block -->
            <xpath expr="//div[@name='plan_block']" position="after">
                <field name="meses_renta"
                    invisible="not is_subscription"
                    placeholder="Ej: 48"
                    string="Plazo (meses)"/>
                <field name="tc_pactado"
                    invisible="meses_renta == 0"
                    placeholder="Ej: 17.50"
                    string="TC Pactado (USD/MXN)"/>
                <field name="cuota_mensual_mxn"
                    invisible="meses_renta == 0"
                    readonly="1"
                    string="Cuota Mensual MXN $ (antes de IVA)"/>
            </xpath>

            <!-- Columna Precio Cotizado USD en las líneas -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="after">
                <field name="precio_venta_usd" optional="show" string="Precio Cotizado USD"/>
            </xpath>

            <!-- Pestaña Contrato de Arrendamiento -->
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Contrato de Arrendamiento" invisible="not es_arrendamiento">
                    <group>
                        <group string="Identificación">
                            <field name="nombre_contrato"
                                readonly="state not in ('draft','sent')"
                                placeholder="Ej: RENTA-GYM-CDMX-001 (vacío = folio de la orden)"/>
                            <field name="cuenta_analitica_id"/>
                        </group>
                        <group string="Valores del Contrato">
                            <field name="valor_contrato_usd"/>
                            <field name="valor_contrato_mxn"/>
                            <field name="meses_renta" readonly="1" string="Plazo (meses)"/>
                            <field name="tc_pactado" readonly="1" string="TC Pactado"/>
                            <field name="cuota_mensual_mxn" readonly="1" string="Cuota Mensual MXN (antes de IVA)"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        La cuenta analítica del contrato se crea automáticamente al confirmar,
                        dentro del plan analítico "Renta". En ella se registran las facturas de
                        renta, la inversión capitalizada y la depreciación mensual de los equipos.
                    </p>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Campo rentable en categoría de producto -->
    <record id="view_category_form_atom_subscriptions" model="ir.ui.view">
        <field name="name">product.category.form.atom.subscriptions</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="es_categoria_rentable"/>
            </field>
        </field>
    </record>

</odoo>
